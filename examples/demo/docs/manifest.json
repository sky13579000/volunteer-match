{
  "default": {
    "roles": [
      "admin"
    ],
    "level": 99
  },
  "rules": [
    {
      "glob": "contracts/제주도청*",
      "acl": {
        "depts": [
          "provincial",
          "finance"
        ],
        "level": 2
      }
    },
    {
      "glob": "contracts/*",
      "acl": {
        "depts": [
          "mice",
          "finance"
        ],
        "level": 2
      }
    },
    {
      "glob": "minutes/*",
      "acl": {
        "depts": [
          "mice",
          "finance",
          "provincial"
        ],
        "level": 1
      }
    },
    {
      "glob": "mail/*",
      "acl": {
        "depts": [
          "mice",
          "finance"
        ],
        "level": 2
      }
    },
    {
      "glob": "finance/*",
      "acl": {
        "roles": [
          "finance"
        ],
        "level": 3
      }
    },
    {
      "glob": "hr/*",
      "acl": {
        "roles": [
          "hr"
        ],
        "level": 3
      }
    },
    {
      "glob": "layouts/*",
      "acl": {
        "level": 1
      }
    },
    {
      "glob": "uploads/*",
      "acl": {
        "roles": [
          "admin"
        ],
        "level": 99
      }
    }
  ]
}