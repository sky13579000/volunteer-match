{
  "store": "workspace/store.db",
  "users": "users.json",
  "docs": {
    "root": "docs",
    "manifest": "docs/manifest.json"
  },
  "entities": {
    "patterns": {
      "project": "EVT-\\d{4}",
      "contract": "CT-\\d{4}-\\d{3}"
    },
    "dictionaries": [
      {
        "type": "customer",
        "table": "customers",
        "column": "name"
      }
    ]
  },
  "structured": {
    "path": "workspace/erp.db",
    "tables": [
      {
        "name": "customers",
        "title": "고객사",
        "key": "id",
        "link": {
          "customer": "name"
        },
        "columns": {
          "id": {},
          "name": {
            "label": "고객사"
          },
          "industry": {
            "label": "업종"
          },
          "credit_grade": {
            "label": "신용등급",
            "roles": [
              "finance"
            ]
          }
        }
      },
      {
        "name": "contracts",
        "title": "계약",
        "key": "id",
        "link": {
          "project": "project_code",
          "contract": "id",
          "customer": "customer_name"
        },
        "columns": {
          "id": {
            "label": "계약번호"
          },
          "project_code": {
            "label": "행사"
          },
          "customer_name": {
            "label": "고객사"
          },
          "amount": {
            "label": "계약금액(원)",
            "min_level": 2
          },
          "margin_rate": {
            "label": "마진율",
            "roles": [
              "finance"
            ]
          },
          "due_date": {
            "label": "납기"
          }
        },
        "row_policy": [
          {
            "roles": [
              "finance"
            ]
          },
          {
            "where": "owner_dept = :dept"
          }
        ]
      },
      {
        "name": "invoices",
        "title": "청구",
        "key": "id",
        "link": {
          "project": "project_code"
        },
        "columns": {
          "id": {
            "label": "청구번호"
          },
          "project_code": {
            "label": "행사"
          },
          "amount": {
            "label": "청구금액(원)"
          },
          "status": {
            "label": "상태"
          }
        },
        "row_policy": [
          {
            "roles": [
              "finance"
            ]
          }
        ]
      }
    ],
    "metrics": [
      {
        "name": "contract_total",
        "label": "계약금액 합계",
        "table": "contracts",
        "agg": "sum",
        "column": "amount",
        "keywords": [
          "합계",
          "총액",
          "총 계약",
          "합산",
          "총 금액"
        ]
      },
      {
        "name": "contract_by_customer",
        "label": "고객사별 계약금액",
        "table": "contracts",
        "agg": "sum",
        "column": "amount",
        "group_by": "customer_name",
        "keywords": [
          "고객사별",
          "거래처별"
        ]
      },
      {
        "name": "unpaid_total",
        "label": "청구 건수/금액",
        "table": "invoices",
        "agg": "sum",
        "column": "amount",
        "group_by": "status",
        "keywords": [
          "미수",
          "수금"
        ]
      }
    ]
  },
  "llm": null,
  "pii": {
    "reveal_roles": [
      "hr"
    ]
  },
  "auth": {
    "mode": "header"
  },
  "examples": [
    "제주관광공사 MICE 위크 계약 금액과 납기 지연 이슈는?",
    "지체상금 조항이 있는 계약과 청구 현황",
    "고객사별 계약금액 합계",
    "EVT-2024 미수 청구 합계",
    "김유치 성과 등급과 보너스"
  ],
  "automation": {
    "contract_check": {
      "table": "contracts",
      "amount_col": "amount",
      "due_col": "due_date"
    }
  },
  "adapters": {
    "slack": {
      "signing_secret_env": "EDM_AI_SLACK_SIGNING_SECRET"
    },
    "webhook": {
      "secret_env": "EDM_AI_WEBHOOK_SECRET"
    }
  },
  "dms": {
    "external_share": {
      "enabled": true,
      "max_days": 30,
      "max_level": 1
    },
    "folders": [
      {
        "path": "MICE유치팀",
        "entries": [
          {
            "type": "dept",
            "id": "mice",
            "role": "editor"
          },
          {
            "type": "dept",
            "id": "finance",
            "role": "viewer"
          }
        ]
      },
      {
        "path": "경영지원팀",
        "entries": [
          {
            "type": "dept",
            "id": "finance",
            "role": "editor"
          }
        ]
      },
      {
        "path": "인사팀",
        "entries": [
          {
            "type": "role",
            "id": "hr",
            "role": "manager"
          }
        ]
      },
      {
        "path": "공용/규정",
        "entries": [
          {
            "type": "all",
            "id": "*",
            "role": "viewer"
          }
        ]
      }
    ]
  },
  "departments": {
    "mice": "MICE유치팀",
    "finance": "경영지원팀",
    "hr": "인사팀",
    "provincial": "도청협력팀",
    "ops": "시설운영팀",
    "it": "정보시스템팀",
    "external": "외부 협력사"
  },
  "dlp": {
    "mode": "warn",
    "block_kinds": [
      "rrn",
      "alien",
      "card",
      "passport"
    ],
    "raise_to": 3,
    "exempt_roles": [
      "hr"
    ]
  },
  "disposal": {
    "allow_self_approval": false
  }
}